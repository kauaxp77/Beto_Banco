# Frontend -- Documento Mestre V4.0
#
# Secao 17: "Chamadas [de IA] saem do backend, nunca do navegador -- a chave de
# API nao pode chegar ao cliente." Vale para toda credencial: tudo que comeca com
# VITE_ e embutido no bundle e fica visivel para qualquer visitante. Este arquivo
# so pode conter endereco publico.

# API da plataforma (backend Spring Boot).
VITE_API_URL=http://localhost:8080/api/v1

# --- Legado: Supabase -------------------------------------------------------
# A V4.0 fixa React + Vite / Java 21 + Spring Boot / PostgreSQL como decisao
# permanente (secao 31). O Supabase segue apenas como PostgreSQL gerenciado e
# como backend das telas ainda nao migradas; as chaves abaixo sao publicaveis
# (anon key), e nenhuma service_role key entra aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
